# Base URL of the Spring Boot backend API.
#
# ".env" is used for production builds (npm run build / Netlify). Netlify also sets
# this value in netlify.toml, so no manual dashboard configuration is required.
VITE_API_BASE_URL=https://tt-exam-backend.onrender.com/api
#
# ".env.development" (tracked, no secrets) overrides this for "npm run dev":
# VITE_API_BASE_URL=http://localhost:8080/api
#
# To test a local backend with a production build, create .env.local (git-ignored):
# VITE_API_BASE_URL=http://localhost:8080/api
#
# Frontend env variables are embedded in the public browser bundle.
# Never put database credentials in this file.
