# Development-only frontend config (no secrets, just the localhost API url).
!frontend/.env.development
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
certs/

# The Aiven CA certificate is a public trust anchor (no private key), so it is safe to commit.
!backend/src/main/resources/tls/aiven-ca.pem

