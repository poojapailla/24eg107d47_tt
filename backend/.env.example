# ---------- Local development secrets template ----------
# Copy this file to ".env" inside the backend folder and fill in the real values.
# ".env" is git-ignored and is loaded automatically through:
#   spring.config.import=optional:file:.env[.properties]
# OS environment variables always take precedence over the values in this file.

# Aiven MySQL - service "mysql" of project 31369ece-619a-48b0-9529-fb60aab0099c
# Host:   mysql-1a44b520-codementorai.d.aivencloud.com
# Port:   17960
# Db:     defaultdb
# User:   avnadmin
# Pass:   <from Aiven > Connection information > Password >
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-1a44b520-codementorai.d.aivencloud.com:17960/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=

# Frontend origins that may call the API (comma separated)
APP_CORS_ALLOWED_ORIGINS=https://24eg107d47tt.netlify.app,http://localhost:5173

# Optional: verified TLS. Run scripts/setup-aiven-tls.ps1 (or .sh) first,
# it prints the correct file: URL for your operating system.
# DB_TRUST_STORE_URL=file:///C:/path/to/backend/certs/aiven-truststore.p12
# DB_TRUST_STORE_PASSWORD=changeit
# DB_TRUST_STORE_TYPE=PKCS12
