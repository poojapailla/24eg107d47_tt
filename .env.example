# Local Docker Compose configuration.
# Copy this file to .env (git-ignored) and adjust as needed.
# These values are throwaway local credentials only - never reuse them anywhere else.

# ---------- MySQL ----------
MYSQL_DATABASE=lab_exam
MYSQL_USER=labexam
MYSQL_PASSWORD=labexam
MYSQL_ROOT_PASSWORD=labexam_root
# Host port for the MySQL container. 3306 is often taken by a MySQL server
# installed on the host, so the stack defaults to 3307.
MYSQL_PORT=3307

# ---------- Backend ----------
BACKEND_PORT=8080
# Origins allowed to call the API. The frontend is served on http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Frontend ----------
FRONTEND_PORT=5173
# Baked into the browser bundle at build time.
VITE_API_BASE_URL=http://localhost:8080/api
